# Glyphio sync server configuration — copy to .env and fill in. Placeholders only; never
# commit a real .env. Every value here is runtime configuration: nothing is compiled in.

# ---- core ----
# Port the HTTP server listens on.
PORT=8787
# Storage backend: sqlite (self-host default) | dynamo (AWS reference deploy).
STORAGE=sqlite
# SQLite database file (sqlite mode). The docker volume mounts /data.
DB_PATH=/data/glyphio.db
# DynamoDB table name (dynamo mode only).
#DYNAMO_TABLE=<TABLE_NAME>

# ---- auth: enable OIDC, static tokens, or both ----
# OIDC: validate bearer JWTs against this issuer's JWKS.
#   OIDC_ISSUER   e.g. https://<YOUR_TENANT>.okta.com/oauth2/default  or  https://login.example.com/realms/main
#   OIDC_AUDIENCE the app's OIDC client ID (the `aud` claim of its ID tokens)
#   TEAMS_CLAIM   the claim carrying the user's team names (array of strings)
#OIDC_ISSUER=<OIDC_ISSUER_URL>
#OIDC_AUDIENCE=<OIDC_CLIENT_ID>
#TEAMS_CLAIM=groups

# Static tokens (BOOTSTRAP / back-compat): use these to create the first owner; day-to-day
# membership should use invite tokens minted at /admin (no env edits, revocable, expirable).
# JSON array of {tokenSha256, sub, teams[], email?}. `email` is optional and
# only used for display in GET /v1/teams/{team}/members. Generate a token with
#   openssl rand -hex 32
# and hash it with
#   printf '%s' '<token>' | shasum -a 256
# Only the SHA-256 digest goes here — the raw token is pasted into the Glyphio app.
# Optional per-token fields: "email" (shown in rosters), "role" (pins the token's role on
# all its teams: reader|writer|manager|admin|owner; explicit role rows override).
#STATIC_TOKENS=[{"tokenSha256":"<64_HEX_SHA256>","sub":"alice","teams":["myteam"],"role":"admin"}]
# Or keep them in a file:
#STATIC_TOKENS_FILE=/data/tokens.json

# ---- RBAC / org ----
# Fallback role for members with team access but no explicit role row, used when org settings
# (managed at /admin → Org settings, stored in the database) don't set one:
# reader|writer|manager|admin|owner.
# Team creation, export policy, and audit retention are org settings too (PUT /admin/v1/org).
# In the default "bootstrap" team-creation mode, the first claim-carrying identity to touch a
# team is auto-granted owner; in "owners"/"admins" modes teams are created explicitly.
DEFAULT_ROLE=writer

# ---- limits ----
# Per-credential request budget per minute (fixed window).
RATE_LIMIT_PER_MIN=60

# ---- logging ----
# tracing filter, e.g. info | glyphio_server=debug,info
RUST_LOG=info
