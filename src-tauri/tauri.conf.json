{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyphio",
  "version": "0.3.2",
  "identifier": "io.glyphio.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/Glyphio/**",
          "$APPDATA/Glyphio/**",
          "$APPCONFIG/Glyphio/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/glyphio-engine",
      "binaries/glyphio-ocr"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "Glyphio Dev"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "glyphio"
        ]
      }
    }
  }
}
